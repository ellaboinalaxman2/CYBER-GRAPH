# Application
APP_NAME=Cyber-Graph-Ingestion
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8001
API_PREFIX=/api/v1

# Redis (Phase 10+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Data Directories
DATA_DIR=./data
SAMPLE_DATA_DIR=./data/samples
FAILED_EVENTS_DIR=./data/failed

# Integration (Phase 3+)
# For collecting from different sources
SYSLOG_PORT=514
WINDOWS_EVENT_LOG=Security