# Application
APP_NAME=Cyber-Graph-Database-Engine
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8003
API_PREFIX=/api/v1
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cyber_graph
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_MAX_CONNECTION_POOL_SIZE=100

# Integration URLs
MEMBER2_URL=http://localhost:8001
MEMBER3_URL=http://localhost:8002
MEMBER5_URL=http://localhost:8004

# Backup
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=7

# Security
JWT_SECRET_KEY=your-secret-key-here
CORS_ORIGINS=["*"]