# Application
APP_NAME=Cyber-Graph-Attack-Engine
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8004
API_PREFIX=/api/v1
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# Member URLs
MEMBER2_URL=http://localhost:8001
MEMBER3_URL=http://localhost:8002
MEMBER4_URL=http://localhost:8003
MEMBER6_URL=http://localhost:8005

# Risk Settings
RISK_LOW_THRESHOLD=20
RISK_MEDIUM_THRESHOLD=40
RISK_HIGH_THRESHOLD=70
RISK_CRITICAL_THRESHOLD=85

# MITRE Settings
MITRE_DATA_PATH=./data/mitre/attack_techniques.json

# Security
JWT_SECRET_KEY=your-super-secret-key-change-in-production
CORS_ORIGINS=["*"]