# Application
APP_NAME=Cyber-Graph-AI-Engine
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8002
API_PREFIX=/api/v1

# ML Settings
RANDOM_SEED=42
MODEL_SAVE_DIR=./data/models
CHECKPOINT_DIR=./data/models/checkpoints

# Data Paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
FEATURE_DIR=./data/features

# Neo4j (Member 4)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# MongoDB (Member 4)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cyber_graph

# Member 2 Integration
INGESTION_API_URL=http://localhost:8001/api/v1

# Member 5 Integration
ATTACK_ENGINE_URL=http://localhost:8003/api/v1

# Model Settings
MODEL_NAME=GraphSAGE
MODEL_VERSION=1.0.0
HIDDEN_CHANNELS=128
NUM_LAYERS=3
DROPOUT=0.2
LEARNING_RATE=0.001
WEIGHT_DECAY=5e-4
MAX_EPOCHS=200
BATCH_SIZE=1024
PATIENCE=20

# Training Settings
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# GPU Settings
USE_GPU=true
GPU_DEVICE=0